apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app: accounts
  name: accounts
  namespace: easybank
spec:
  replicas: 1
  selector:
    matchLabels:
      app: accounts
  template:
    metadata:
      labels:
        app: accounts
    spec:
      containers:
      - env:
        - name: SPRING_APPLICATION_NAME
          value: accounts
        - name: SPRING_PROFILES_ACTIVE
          value: prod
        - name: SPRING_CONFIG_IMPORT
          value: configserver:http://configserver:8071/
        - name: EUREKA_CLIENT_SERVICEURL_DEFAULTZONE
          value: http://eurekaserver:8070/eureka/
        - name: EUREKA_CLIENT_ENABLED
          value: "false"
        - name: SPRING_CLOUD_KUBERNETES_DISCOVERY_ENABLED
          value: "true"
        - name: SPRING_CLOUD_KUBERNETES_DISCOVERY_DISCOVERY_SERVER_URL
          value: http://discoveryserver:8761
        - name: SPRING_CLOUD_STREAM_KAFKA_BINDER_BROKERS
          value: kafka:19092
        - name: OTEL_SERVICE_NAME
          value: accounts
        - name: OTEL_TRACES_EXPORTER
          value: none
        - name: OTEL_LOGS_EXPORTER
          value: none
        - name: OTEL_METRICS_EXPORTER
          value: none
        - name: MANAGEMENT_OTLP_METRICS_EXPORT_ENABLED
          value: "false"
        image: eazybytes/accounts:s14
        imagePullPolicy: IfNotPresent
        livenessProbe:
          httpGet:
            path: /actuator/health/liveness
            port: http
          periodSeconds: 20
        name: accounts
        ports:
        - containerPort: 8080
          name: http
        readinessProbe:
          httpGet:
            path: /actuator/health/readiness
            port: http
          periodSeconds: 10
        resources:
          limits:
            memory: 700Mi
          requests:
            cpu: 100m
            memory: 384Mi
        startupProbe:
          failureThreshold: 36
          httpGet:
            path: /actuator/health/liveness
            port: http
          periodSeconds: 5
