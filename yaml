apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app: kafka
  name: kafka
  namespace: easybank
spec:
  replicas: 1
  selector:
    matchLabels:
      app: kafka
  template:
    metadata:
      labels:
        app: kafka
    spec:
      containers:
      - env:
        - name: KAFKA_NODE_ID
          value: "1"
        - name: KAFKA_PROCESS_ROLES
          value: broker,controller
        - name: KAFKA_LISTENERS
          value: CONTROLLER://:29093,PLAINTEXT://:19092,PLAINTEXT_HOST://:9092
        - name: KAFKA_ADVERTISED_LISTENERS
          value: PLAINTEXT://kafka:19092,PLAINTEXT_HOST://localhost:9092
        - name: KAFKA_LISTENER_SECURITY_PROTOCOL_MAP
          value: CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
        - name: KAFKA_INTER_BROKER_LISTENER_NAME
          value: PLAINTEXT
        - name: KAFKA_CONTROLLER_LISTENER_NAMES
          value: CONTROLLER
        - name: KAFKA_CONTROLLER_QUORUM_VOTERS
          value: 1@127.0.0.1:29093
        - name: CLUSTER_ID
          value: 4L6g3nShT-eMCtK--X86sw
        - name: KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR
          value: "1"
        - name: KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR
          value: "1"
        - name: KAFKA_TRANSACTION_STATE_LOG_MIN_ISR
          value: "1"
        - name: KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS
          value: "0"
        - name: KAFKA_NUM_PARTITIONS
          value: "3"
        - name: KAFKA_HEAP_OPTS
          value: -Xms256m -Xmx512m
        - name: KAFKA_LOG_DIRS
          value: /tmp/kraft-combined-logs
        image: apache/kafka:4.1.1
        imagePullPolicy: IfNotPresent
        livenessProbe:
          periodSeconds: 20
          tcpSocket:
            port: plaintext
        name: kafka
        ports:
        - containerPort: 19092
          name: plaintext
        - containerPort: 9092
          name: host
        - containerPort: 29093
          name: controller
        readinessProbe:
          periodSeconds: 10
          tcpSocket:
            port: plaintext
        resources:
          limits:
            memory: 1Gi
          requests:
            cpu: 200m
            memory: 512Mi
        startupProbe:
          failureThreshold: 24
          periodSeconds: 5
          tcpSocket:
            port: plaintext
        volumeMounts:
        - mountPath: /tmp/kraft-combined-logs
          name: data
      securityContext:
        fsGroup: 1000
      volumes:
      - emptyDir: {}
        name: data
---
